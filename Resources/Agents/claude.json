{
  "descriptorVersion": 1,
  "id": "claude",
  "name": { "zh-Hans": "Claude Code", "en": "Claude Code" },
  "subtitle": {
    "zh-Hans": "claude (Anthropic)",
    "en": "claude (Anthropic)"
  },
  "icon": "sparkles",
  "glyph": "✳",
  "iconImage": "claude.svg",
  "tint": "#D97757",
  "homepage": "https://code.claude.com/docs/en/settings",

  "root": { "env": "CLAUDE_CONFIG_DIR", "default": "~/.claude" },
  "detect": {
    "paths": ["~/.claude", "~/.claude.json"],
    "cli": {
      "name": "claude",
      "package": "@anthropic-ai/claude-code",
      "loginShellLookup": true,
      "versionArgs": ["--version"],
      "candidates": [
        "~/.nvm/versions/node/*/bin/claude",
        "~/.claude/local/claude",
        "~/.bun/bin/claude",
        "/opt/homebrew/bin/claude",
        "/usr/local/bin/claude"
      ]
    }
  },

  "write": {
    "backup": { "suffix": ".bak-agentkit", "keep": 10 },
    "scopeGuard": ["$ROOT", "$HOME", "/tmp"]
  },

  "surfaces": [
    {
      "id": "settings",
      "kind": "settings",
      "title": { "zh-Hans": "通用设置", "en": "Settings" },
      "icon": "slider.horizontal.3",
      "shape": "typed-json",
      "file": "$ROOT/settings.json",
      "schema": "claude-code"
    },

    {
      "id": "mcp",
      "kind": "mcp",
      "title": { "zh-Hans": "MCP 服务器", "en": "MCP Servers" },
      "icon": "point.3.connected.trianglepath.dotted",
      "shape": "mcp-servers-map",
      "serverKey": "mcpServers",
      "layers": [
        {
          "path": "~/.claude.json",
          "scope": "user",
          "precedence": 10,
          "writable": true,
          "note": {
            "zh-Hans": "Claude Code 的全局配置。它同时保存账号、用量统计和每个项目的历史，所以这个文件几乎每次运行 claude 都会被改写；AgentKit 落盘前会比对哈希，发现被改过就拒绝写入。",
            "en": "Claude Code's global config. It also holds the account, usage stats and per-project history, so running claude rewrites this file almost every time; AgentKit compares hashes before writing and refuses when it changed underneath."
          }
        },
        {
          "path": "$CWD/.mcp.json",
          "scope": "project",
          "precedence": 30,
          "writable": true,
          "note": {
            "zh-Hans": "跟着仓库走的项目级 MCP 配置，通常是要提交的。",
            "en": "Project-level MCP config that travels with the repo; usually committed."
          }
        }
      ]
    },

    {
      "id": "skills",
      "kind": "skills",
      "title": { "zh-Hans": "Skills", "en": "Skills" },
      "icon": "puzzlepiece.extension",
      "shape": "skill-dirs",
      "ignore": [".git", "node_modules", ".venv", "venv", "logs", ".cache", "dist", "build"],
      "maxDepth": 5,
      "roots": [
        { "path": "$ROOT/skills", "scope": "user", "writable": true },
        { "path": "$CWD/.claude/skills", "scope": "project", "writable": true }
      ]
    },

    {
      "id": "subagents",
      "kind": "subagents",
      "title": { "zh-Hans": "子 Agents", "en": "Subagents" },
      "icon": "person.2",
      "shape": "md-frontmatter",
      "roots": [
        { "path": "$ROOT/agents", "scope": "user", "writable": true },
        { "path": "$CWD/.claude/agents", "scope": "project", "writable": true }
      ],
      "frontmatter": {
        "required": ["name", "description"],
        "fields": ["name", "description", "tools", "model"]
      }
    },

    {
      "id": "sessions",
      "kind": "sessions",
      "title": { "zh-Hans": "会话", "en": "Sessions" },
      "icon": "clock.arrow.circlepath",
      "shape": "jsonl-sessions",
      "root": "$ROOT/projects",
      "sessions": {
        "recursive": true,
        "headerScanLines": 40,
        "header": {
          "id": "sessionId",
          "cwd": "cwd",
          "timestamp": "timestamp"
        },
        "message": {
          "type": "assistant",
          "types": ["user", "assistant"],
          "payload": "message",
          "role": "role",
          "text": "content",
          "usage": "usage",
          "tokens": "input_tokens,output_tokens,cache_read_input_tokens,cache_creation_input_tokens"
        }
      },
      "cli": { "resume": ["--resume"] }
    },

    {
      "id": "instructions",
      "kind": "instructions",
      "title": { "zh-Hans": "全局指令", "en": "Instructions" },
      "icon": "text.book.closed",
      "shape": "md",
      "files": [
        { "path": "$ROOT/CLAUDE.md", "role": "instructions", "precedence": 10 },
        { "path": "$CWD/CLAUDE.md", "role": "project", "precedence": 20 },
        { "path": "$CWD/CLAUDE.local.md", "role": "project", "precedence": 21 }
      ],
      "discovery": {
        "filenames": ["CLAUDE.md", "CLAUDE.local.md"],
        "walkUpFromCwd": true
      }
    }
  ]
}
